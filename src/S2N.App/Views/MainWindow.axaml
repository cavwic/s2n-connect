<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="S2N.Views.MainWindow"
        Title="S2N Connect"
        Icon="avares://S2N/Assets/s2n-vps-vpn.ico"
        Width="1020"
        Height="860"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18" Spacing="10">
      <StackPanel Spacing="2">
        <TextBlock Text="S2N" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="为你的 VPS 增加 VPN 功能"
                   Opacity="0.68"/>
      </StackPanel>

      <Border Classes="card">
        <Grid ColumnDefinitions="170,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="7">
          <TextBlock Grid.Row="0" Text="本地 IP 及位置"/>
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LocalIpText"
                     Text="获取中" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Text="出口 IP 及位置"/>
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ExitIpText"
                     Text="未连接" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Text="连接状态"/>
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ConnectionText"
                     Text="未连接"/>
          <TextBlock Grid.Row="3" Text="VPS 部署状态"/>
          <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VpsStatusText"
                     Text="未检测" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Text="sing-box 部署状态"/>
          <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SingBoxStatusText"
                     Text="未检测" TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="部署" FontSize="19" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="170,*,Auto"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="7" ColumnSpacing="8">
            <TextBlock Grid.Row="0" Text="VPS 地址" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="VpsHostBox"
                     PlaceholderText="例如 203.0.113.10"/>
            <Button Grid.Row="0" Grid.Column="2" x:Name="TestVpsButton"
                    Content="测试 SSH" Click="TestVps_Click"/>

            <TextBlock Grid.Row="1" Text="SSH 用户 / 管理端口" VerticalAlignment="Center"/>
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,120" ColumnSpacing="8">
              <TextBox x:Name="VpsUserBox" PlaceholderText="root"/>
              <TextBox Grid.Column="1"
         x:Name="VpsPortBox"
         MaxLength="5"
         HorizontalContentAlignment="Center"
         PlaceholderText="实际 SSH 端口"
         ToolTip.Tip="填写服务器实际的 SSH TCP 端口。22 无法访问时，须先在服务器配置并放行备用端口；VPN 的 UDP 443 不用于 SSH。"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="SSH 私钥" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="SshKeyBox"
                     IsReadOnly="True" PlaceholderText="连接成功后才保存路径"/>
            <Button Grid.Row="2" Grid.Column="2" Content="选择私钥"
                    Click="ChooseSshKey_Click"/>

            <TextBlock Grid.Row="3" Text="私钥口令" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="KeyPassphraseBox"
                     PasswordChar="●" PlaceholderText="仅本次使用，不保存"/>

            <TextBlock Grid.Row="4" Text="sing-box 路径" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="SingBoxPathBox"
                     IsReadOnly="True" PlaceholderText="用户选择安装目录"/>
            <Button Grid.Row="4" Grid.Column="2" Content="选择并安装"
                    Click="InstallSingBox_Click"/>

            <TextBlock Grid.Row="5" Text="部署操作" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="一键部署"
                      Click="OneClickDeploy_Click"/>
              <Button Content="仅部署 VPS" Click="DeployVps_Click"/>
              <ProgressBar x:Name="ProgressBar" Width="210"
                           Minimum="0" Maximum="100" IsVisible="False"/>
            </StackPanel>
            <TextBlock Grid.Row="6" Text="部署协议" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="TransportBox"
                      HorizontalAlignment="Stretch" SelectionChanged="Transport_SelectionChanged">
              <ComboBoxItem Tag="hysteria2" Content="UDP 443（Hysteria 2）"/>
              <ComboBoxItem Tag="vless" Content="TCP 443（VLESS + REALITY）"/>
            </ComboBox>
            <TextBlock Grid.Row="7" Text="本机 HTTP 代理" VerticalAlignment="Center"/>
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="SshProxyPortBox"
                     Text="0" MaxLength="5"
                     ToolTip.Tip="填写已运行的本机 HTTP 代理端口；0 表示直连。仅用于 SSH 管理连接，不会修改服务器端口。"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="偏好设置" FontSize="19" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="Auto,180,*,*,*" ColumnSpacing="14">
            <TextBlock Text="主题" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="ThemeModeBox"
                      SelectionChanged="ThemeMode_SelectionChanged">
              <ComboBoxItem Tag="system" Content="跟随系统"/>
              <ComboBoxItem Tag="light" Content="浅色"/>
              <ComboBoxItem Tag="dark" Content="深色"/>
            </ComboBox>
            <CheckBox Grid.Column="2" x:Name="GlobalModeCheckBox"
                      Content="全局模式" VerticalAlignment="Center"
                      Click="GlobalMode_Click"/>
            <CheckBox Grid.Column="3" x:Name="AutoStartCheckBox"
                      Content="开机启动" VerticalAlignment="Center"
                      Click="AutoStart_Click"/>
            <CheckBox Grid.Column="4" x:Name="AutoConnectCheckBox"
                      Content="自动连接" VerticalAlignment="Center"
                      Click="AutoConnect_Click"/>
          </Grid>
          <TextBlock Text="全局模式仅代理公网流量，局域网与 VPS 地址保持直连。自动连接需先手动连接成功一次。"
                     Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="使用" FontSize="19" FontWeight="SemiBold"/>
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <Button Classes="primary" x:Name="ConnectButton"
                    Content="连接" Click="Connect_Click"/>
            <Button x:Name="StopButton" Content="停止"
                    Click="Stop_Click"/>
            <Button Content="规则管理" Click="Rules_Click"/>
            <Button Content="导入连接配置" Click="ImportProfile_Click"/>
            <Button x:Name="ExportMobileProfileButton" Content="导出手机配置"/>
            <Button Content="刷新状态" Click="Refresh_Click"/>
            <Button Content="退出" Click="Exit_Click"/>
          </WrapPanel>
          <TextBlock Text="手机配置含连接凭据，请妥善保管。"
                     Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
          <TextBlock Text="已有节点：安装本地核心后导入连接配置，即可连接，无需 SSH。"
                     Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
