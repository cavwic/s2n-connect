<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>S2N</AssemblyName>
    <RootNamespace>S2N</RootNamespace>
    <ApplicationIcon>Assets/s2n-vps-vpn.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeFrameworkVersion>8.0.33</RuntimeFrameworkVersion>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>0.4.0-beta.4</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.4</FileVersion>
    <InformationalVersion>0.4.0-beta.4</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="SharpCompress" Version="0.50.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve application JSON models, anonymous payloads and XAML factories. -->
    <TrimmerRootAssembly Include="S2N" />
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Server/*.py" />
  </ItemGroup>
</Project>
